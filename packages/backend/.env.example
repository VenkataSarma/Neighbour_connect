# ---------------------------------------------------------------------------
# Backend environment variables
# Copy to .env for local development. On Render, add these in
# Dashboard -> your service -> Environment.
# Render sets PORT automatically - do not add it there.
# ---------------------------------------------------------------------------

PORT=5000
NODE_ENV=development

# MongoDB Atlas connection string
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/neighbourhood_connect

# JWT secrets - use long random strings in production
JWT_SECRET=change-me-to-a-long-random-string
JWT_REFRESH_SECRET=change-me-to-another-long-random-string
JWT_EXPIRES_IN=7d
JWT_REFRESH_EXPIRES_IN=30d

# Public URLs of the deployed apps (used for CORS, Socket.IO and email links)
# Production examples:
# CLIENT_URL=https://your-site.netlify.app
# ADMIN_URL=https://your-admin-site.netlify.app
CLIENT_URL=http://localhost:5173
ADMIN_URL=http://localhost:5174

# Cloudinary (image uploads)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# SMTP / email (optional - email is disabled if empty)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=Neighbourhood Connect <noreply@example.com>

# Firebase Admin (push notifications) - pick ONE option:
# Option A (easiest for Render): paste the whole service account JSON on one line
FIREBASE_SERVICE_ACCOUNT_JSON=
# Option B: individual values from the service account JSON
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
# Keep the \n escapes literal when pasting the private key
FIREBASE_PRIVATE_KEY=
