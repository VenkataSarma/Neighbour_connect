{
  "expo": {
    "name": "Neighbourhood Connect",
    "slug": "neighbourhood-connect",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "assetBundlePatterns": ["**/*"],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.neighbourhoodconnect.app"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.foreground.png",
        "backgroundColor": "#ffffff"
      },
      "package": "com.neighbourhoodconnect.app"
    },
    "plugins": [
      "expo-location",
      "expo-notifications"
    ]
  }
}
